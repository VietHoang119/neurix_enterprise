# Copy to .env for local development.
MODE=dev
PORT=8000

# Firebase Auth
FIREBASE_PROJECT_ID=

# Cloud SQL (Postgres 15+, pgvector). See db/session.py for how these are used.
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Local-only fallback (e.g. docker-compose postgres), never used on Cloud Run.
LOCAL_DATABASE_URL=

FRONTEND_URL=http://localhost:5173
