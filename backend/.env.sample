# Copy to .env for local development.
MODE=dev
PORT=8000

# Firebase Auth
FIREBASE_PROJECT_ID=

# Cloud SQL (Postgres 15+, pgvector). See db/session.py for how these are used.
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Local-only fallback (e.g. docker-compose postgres), never used on Cloud Run.
LOCAL_DATABASE_URL=

# SQLAlchemy engine pool sizing. Defaults (5 / 10) match SQLAlchemy's own
# defaults. Tune down per-service when many Cloud Run services share one
# Cloud SQL instance's max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

FRONTEND_URL=http://localhost:5173

# Slack App (Secret Manager on Cloud Run: slack-bot-token, slack-signing-secret)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Optional: Slack OAuth install callback (links a team to its Slack workspace)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=

# Cloud Storage bucket for original note/file content (view_raw)
RAW_STORAGE_BUCKET=

# Gemini (GOOGLE_API_KEY is Secret Manager on Cloud Run: gemini-api-key)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order only when a model returns 404 NotFound.
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash
