locals {
  labels = merge(
    { managed_by = "terraform", component = "neurix-tenant", tenant = var.tenant_id },
    var.labels,
  )

  db_name   = "neurix_${var.tenant_id}"
  db_user   = "app_${var.tenant_id}"
  run_sa_id = "neurix-${var.tenant_id}-run"
}

# ---------------------------------------------------------------------------
# Database + app user. Creating these is a Cloud SQL Admin API call (no
# direct DB connection needed at apply time) — schema/tables/grants are the
# migration runner's job (scripts/provision.sh's migrate-and-build phase),
# never Terraform's (see deploy/README.md "Things Terraform must NOT do").
# ---------------------------------------------------------------------------
resource "google_sql_database" "tenant" {
  project  = var.project_id
  instance = local.platform.sql_instance_name
  name     = local.db_name

  # Destroy-order only. Terraform destroys a resource BEFORE the resources
  # it depends on (reverse of creation order), so this makes the database
  # get dropped first and google_sql_user.tenant only afterwards. Without
  # it the two were destroyed in parallel and Cloud SQL rejected the user
  # delete ("role ... cannot be dropped because some objects depend on it")
  # while the role still owned/held privileges on objects in the database.
  # Creation order is unchanged in effect: the user was already created
  # independently, and the database now simply waits for it.
  depends_on = [google_sql_user.tenant]
}

resource "random_password" "db_user" {
  length  = 32
  special = false
}

resource "google_sql_user" "tenant" {
  project  = var.project_id
  instance = local.platform.sql_instance_name
  name     = local.db_user
  password = random_password.db_user.result
}

# ---------------------------------------------------------------------------
# Secret Manager. The DB password secret's value is populated by Terraform
# (it's generated by Terraform, above). The Slack and Gemini secrets are
# created as empty shells — their values are added by
# scripts/provision.sh's manual-pause phase using `gcloud secrets versions
# add` with `printf '%s'`, never here, so a secret value never has to pass
# through a .tfvars file or Terraform state as plan-time input (it still
# ends up in state as an attribute of the *version* resource for
# db-password-<tenant> since Terraform itself generated it, which is
# unavoidable for a Terraform-managed random_password; the Slack/Gemini
# secrets avoid this entirely by having no version resource here at all).
# ---------------------------------------------------------------------------
resource "google_secret_manager_secret" "db_password" {
  project   = var.project_id
  secret_id = "db-password-${var.tenant_id}"

  replication {
    auto {}
  }

  labels = local.labels
}

resource "google_secret_manager_secret_version" "db_password" {
  secret      = google_secret_manager_secret.db_password.id
  secret_data = random_password.db_user.result
}

resource "google_secret_manager_secret" "slack_bot_token" {
  project   = var.project_id
  secret_id = "slack-bot-token-${var.tenant_id}"

  replication {
    auto {}
  }

  labels = local.labels

  lifecycle {
    # A version is added out-of-band by scripts/provision.sh; never let a
    # future `terraform apply` decide the secret "should" have no versions
    # and touch it.
    ignore_changes = [labels]
  }
}

resource "google_secret_manager_secret" "slack_signing_secret" {
  project   = var.project_id
  secret_id = "slack-signing-secret-${var.tenant_id}"

  replication {
    auto {}
  }

  labels = local.labels

  lifecycle {
    ignore_changes = [labels]
  }
}

# In external mode, no per-tenant Gemini secret is created at all — the
# handoff supplies the id of an EXISTING Gemini API key secret
# (external_gemini_api_key_secret_id) and this module only grants the
# tenant's runtime SA read access to it (see gemini_api_key_accessor below
# and local.gemini_api_key_secret_id in platform_source.tf's sibling local).
resource "google_secret_manager_secret" "gemini_api_key" {
  count = var.platform_mode == "remote_state" ? 1 : 0

  project   = var.project_id
  secret_id = "gemini-api-key-${var.tenant_id}"

  replication {
    auto {}
  }

  labels = local.labels

  lifecycle {
    ignore_changes = [labels]
  }
}

locals {
  # remote_state mode: a fresh, tenant-owned secret this module creates.
  # external mode: an existing secret this module never creates or writes
  # to — only grants read access on, via gemini_api_key_accessor below.
  gemini_api_key_secret_id = var.platform_mode == "remote_state" ? google_secret_manager_secret.gemini_api_key[0].secret_id : var.external_gemini_api_key_secret_id
}

# ---------------------------------------------------------------------------
# Runtime service account — least privilege, access only to this tenant's
# own secrets (never another tenant's).
# ---------------------------------------------------------------------------
resource "google_service_account" "run" {
  project      = var.project_id
  account_id   = local.run_sa_id
  display_name = "Neurix tenant ${var.tenant_id} (Cloud Run)"
}

resource "google_secret_manager_secret_iam_member" "db_password_accessor" {
  project   = var.project_id
  secret_id = google_secret_manager_secret.db_password.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.run.email}"
}

resource "google_secret_manager_secret_iam_member" "slack_bot_token_accessor" {
  project   = var.project_id
  secret_id = google_secret_manager_secret.slack_bot_token.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.run.email}"
}

resource "google_secret_manager_secret_iam_member" "slack_signing_secret_accessor" {
  project   = var.project_id
  secret_id = google_secret_manager_secret.slack_signing_secret.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.run.email}"
}

resource "google_secret_manager_secret_iam_member" "gemini_api_key_accessor" {
  project   = var.project_id
  secret_id = local.gemini_api_key_secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${google_service_account.run.email}"
}

resource "google_project_iam_member" "run_sql_client" {
  project = var.project_id
  role    = "roles/cloudsql.client"
  member  = "serviceAccount:${google_service_account.run.email}"
}

# Signed URLs on Cloud Run go through IAM signBlob (no local private key) —
# the runtime SA needs to be allowed to create tokens for itself. See
# services/raw_storage.py and docs/DEPLOYMENT_RUNBOOK.md step 15.
resource "google_service_account_iam_member" "run_token_creator_self" {
  service_account_id = google_service_account.run.name
  role               = "roles/iam.serviceAccountTokenCreator"
  member             = "serviceAccount:${google_service_account.run.email}"
}
